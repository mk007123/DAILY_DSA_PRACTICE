class Solution {
public:
    int search(vector<int>& arr, int target) {
        int n=arr.size();
        int start=0;
        int end=n-1;
        while(start<=end){
            int mid=(start+end)/2;
            int ele=arr[mid];
            if(ele==target){
                return mid;

            }
            else if(ele<target){
                start=mid+1;

            }
            else{
                end=mid-1;

            }
        }
        return -1;
        

    }
};
