class Solution {
public:

    // Function to find the number of rotations performed on
    // a sorted array.
    // The number of rotations is equal to the index of the
    // minimum element.
    int findKRotation(vector<int> &arr) {

        // Store the size of the array
        int n = arr.size();

        // 'start' points to the beginning of the current search range
        int start = 0;

        // 'end' points to the last index of the current search range
        int end = n - 1;

        // Store the first element of the array.
        // It is used as a reference to determine whether
        // the middle element belongs to the left sorted portion.
        int s1 = arr[0];

        // Store the last element of the array.
        // (Not used in this solution, but declared.)
        int e2 = arr[n - 1];

        // Initially assume the minimum element is at index 0.
        // If a smaller element is found later,
        // update 'mini_ind'.
        int mini_ind = 0;

        // Continue searching while the search range is valid.
        while (start <= end) {

            // Find the middle index of the current search range
            int mid = (start + end) / 2;

            // If the middle element is greater than or equal to
            // the first element, then it belongs to the left sorted portion.
            // The minimum element cannot be at 'mid',
            // so search in the right half.
            if (arr[mid] >= s1) {
                start = mid + 1;
            }

            // Otherwise, the middle element belongs to the
            // right sorted portion.
            // It is a possible minimum element.
            else {

                // If the current middle element is smaller than
                // the minimum element found so far,
                // update its index.
                if (arr[mid] < arr[mini_ind]) {
                    mini_ind = mid;
                }

                // Continue searching on the left side
                // to check if an even smaller element exists.
                end = mid - 1;
            }
        }

        // Return the index of the minimum element,
        // which is equal to the number of rotations.
        return mini_ind;
    }
};
