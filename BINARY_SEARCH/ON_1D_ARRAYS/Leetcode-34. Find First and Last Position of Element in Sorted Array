class Solution {
public:

    // Function to find the first occurrence of the target
    int f1(vector<int>& arr, int target) {

        // Store the size of the array
        int n = arr.size();

        // Assume the target is not present initially
        int ans = -1;

        // 'start' points to the beginning of the current search range
        int start = 0;

        // 'end' points to the last index of the current search range
        int end = n - 1;

        // Continue searching while the search range is valid
        while (start <= end) {

            // Find the middle index of the current search range
            int mid = (start + end) / 2;

            // Store the middle element for easier comparison
            int ele = arr[mid];

            // If the middle element is smaller than the target,
            // the target can only be present in the right half.
            if (ele < target) {
                start = mid + 1;
            }

            // If the middle element is equal to the target,
            // this is a possible first occurrence.
            // Store its index and continue searching on the left
            // to check if an earlier occurrence exists.
            else if (ele == target) {
                ans = mid;
                end = mid - 1;
            }

            // If the middle element is greater than the target,
            // search only in the left half.
            else {
                end = mid - 1;
            }
        }

        // Return the index of the first occurrence.
        // If the target is absent, returns -1.
        return ans;
    }

    // Function to find the last occurrence of the target
    int f2(vector<int>& arr, int target) {

        // Store the size of the array
        int n = arr.size();

        // Assume the target is not present initially
        int ans = -1;

        // 'start' points to the beginning of the current search range
        int start = 0;

        // 'end' points to the last index of the current search range
        int end = n - 1;

        // Continue searching while the search range is valid
        while (start <= end) {

            // Find the middle index of the current search range
            int mid = (start + end) / 2;

            // Store the middle element for easier comparison
            int ele = arr[mid];

            // If the middle element is smaller than the target,
            // search in the right half.
            if (ele < target) {
                start = mid + 1;
            }

            // If the middle element is equal to the target,
            // this is a possible last occurrence.
            // Store its index and continue searching on the right
            // to check if a later occurrence exists.
            else if (ele == target) {
                ans = mid;
                start = mid + 1;
            }

            // If the middle element is greater than the target,
            // search only in the left half.
            else {
                end = mid - 1;
            }
        }

        // Return the index of the last occurrence.
        // If the target is absent, returns -1.
        return ans;
    }

    // Function to return the first and last occurrence
    // of the target in the sorted array.
    vector<int> searchRange(vector<int>& arr, int target) {

        // Store the size of the array
        int n = arr.size();

        // Find the first occurrence of the target
        int first_occ = f1(arr, target);

        // If the target is not found,
        // both first and last occurrences are -1.
        if (first_occ == -1) {
            return {-1, -1};
        }

        // Find the last occurrence of the target
        int last_occ = f2(arr, target);

        // Return both indices
        return {first_occ, last_occ};
    }
};
