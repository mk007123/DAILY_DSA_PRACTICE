class Solution {
public:

    // Function to find the floor of the target in a sorted array.
    // Floor = Greatest element that is less than or equal to the target.
    // The function returns the index of the floor element.
    // If no floor exists, it returns -1.
    int findFloor(vector<int>& arr, int target) {

        // Store the size of the array
        int n = arr.size();

        // Assume no floor exists initially.
        // If no element <= target is found, -1 will be returned.
        int ans = -1;

        // 'start' points to the beginning of the current search range
        int start = 0;

        // 'end' points to the last index of the current search range
        int end = n - 1;

        // Continue searching while the search range is valid
        while (start <= end) {

            // Find the middle index of the current search range
            int mid = (start + end) / 2;

            // Store the middle element for easier comparison
            int ele = arr[mid];

            // If the middle element is less than or equal to the target,
            // it is a possible floor.
            // Store its index and search in the right half
            // to find a larger element that is still <= target.
            if (ele <= target) {
                ans = mid;
                start = mid + 1;
            }

            // Otherwise, the middle element is greater than the target.
            // It cannot be the floor, and neither can any element to its right.
            // So continue searching in the left half.
            else {
                end = mid - 1;
            }
        }

        // Return the index of the greatest element <= target.
        // If no such element exists, returns -1.
        return ans;
    }
};
