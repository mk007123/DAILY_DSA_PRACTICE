class Solution {
  public:
    int upperBound(vector<int>& arr, int target) {
        // Store the size of the array
        int n = arr.size();

        // Assume the answer is n initially.
        // If no element > target is found, this value will be returned.
        int ans = n;

        // 'start' points to the beginning of the current search range
        int start = 0;

        // 'end' points to the last index of the current search range
        int end = n - 1;

        // Continue searching while the search range is valid
        while (start <= end) {

            // Find the middle index of the current search range
            int mid = (start + end) / 2;

            // Store the middle element for easier comparison
            int ele = arr[mid];

            // If the middle element is smaller than the target or equals to the target,
            // then it cannot be the lower bound.
            // Also, every element before it is smaller or equal,
            // so search only in the right half.
            if (ele <=target) {
                start = mid + 1;
            }

            // Otherwise, ele > target.
            // This index can be a possible lower bound.
            // Store it as the current answer and continue searching
            // in the left half to find an even smaller valid index.
            else  {
                ans = mid;
                end = mid - 1;
            }
        }

        // Return the first index where element > target.
        // If no such index exists, returns n.
        return ans;
        
        
    }
};
