class Solution {
public:

    // Function to search for the target in a rotated sorted array
    // that may contain duplicate elements.
    // Returns true if the target is found, otherwise false.
    bool search(vector<int>& arr, int target) {

        // Store the size of the array
        int n = arr.size();

        // 'start' points to the beginning of the current search range
        int start = 0;

        // 'end' points to the last index of the current search range
        int end = n - 1;

        // Continue searching while the search range is valid
        while (start <= end) {

            // Store the current first element of the search range.
            // This helps determine whether the left half is sorted.
            int s1 = arr[start];

            // Store the current last element of the search range.
            // This helps determine whether the right half is sorted.
            int e2 = arr[end];

            // Find the middle index of the current search range
            int mid = (start + end) / 2;

            // If the middle element is the target,
            // return true immediately.
            if (arr[mid] == target) {
                return true;
            }

            // If the first, middle, and last elements are all equal,
            // we cannot determine which half is sorted because of duplicates.
            // Shrink the search space from both ends.
            else if (s1 == arr[mid] && s1 == e2) {
                start++;
                end--;
            }

            // Check whether the middle element belongs to
            // the left sorted portion.
            else if (arr[mid] >= s1) {

                // If the target also lies in the left sorted portion
                // and is smaller than the middle element,
                // search in the left half.
                if (target >= s1 && target < arr[mid]) {
                    end = mid - 1;
                }

                // Otherwise, search in the right half.
                else {
                    start = mid + 1;
                }
            }

            // Otherwise, the middle element belongs to
            // the right sorted portion.
            else {

                // If the target lies in the right sorted portion
                // and is greater than the middle element,
                // search in the right half.
                if (target > arr[mid] && target <= e2) {
                    start = mid + 1;
                }

                // Otherwise, search in the left half.
                else {
                    end = mid - 1;
                }
            }
        }

        // If the loop ends, the target is not present in the array.
        return false;
    }
};
