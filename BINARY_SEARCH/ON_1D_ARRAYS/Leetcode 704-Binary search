class Solution {
public:
    // Function to search for the target element in a sorted array
    int search(vector<int>& arr, int target) {

        // Store the size of the array
        int n = arr.size();

        // 'start' points to the first index of the current search range
        int start = 0;

        // 'end' points to the last index of the current search range
        int end = n - 1;

        // Continue searching as long as the search range is valid
        // (i.e., start index has not crossed the end index)
        while (start <= end) {

            // Find the middle index of the current search range
            // (Your code uses the normal formula)
            int mid = (start + end) / 2;

            // Store the middle element for easier comparison
            int ele = arr[mid];

            // If the middle element is equal to the target,
            // we have found the target, so return its index.
            if (ele == target) {
                return mid;
            }

            // If the middle element is smaller than the target,
            // then the target can only be present in the right half.
            // Ignore the left half and move 'start' forward.
            else if (ele < target) {
                start = mid + 1;
            }

            // Otherwise, the middle element is greater than the target.
            // So the target can only be present in the left half.
            // Ignore the right half and move 'end' backward.
            else {
                end = mid - 1;
            }
        }

        // If the loop ends, it means the target was not found
        // in the array, so return -1.
        return -1;
    }
};
